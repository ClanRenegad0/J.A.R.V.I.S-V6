function escolheTema(){
  const r=Math.random();
  const cand=toks(M.conv_.map(c=>c.q).join(' ')+' '+M.fatos.filter(f=>f.tag==='usuário').map(f=>f.x).join(' ')).filter(w=>w.length>=5);
  if(r<.4&&cand.length)return {q:cand[Math.floor(Math.random()*cand.length)],idx:0};
  if(r<.8){const pool=M.fatos.map(f=>f.tag).concat(BASE.map(f=>f.t)).filter(x=>x&&x!=='usuário'&&x!=='notícia');return {q:pool[Math.floor(Math.random()*pool.length)],idx:1+Math.floor(Math.random()*3)}}
  return null;
}
