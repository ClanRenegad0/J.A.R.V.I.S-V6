    let adds=0;
    for(let i=0;i<BASE.length&&adds<3;i++){
      if((baseSeed&&baseSeed.has(i))||baseExtra.includes(i))continue;
      if(tk(BASE[i].t+' '+BASE[i].x).some(w=>t.has(w))){if(baseExtra.length>=10)baseExtra.shift();baseExtra.push(i);adds++}
