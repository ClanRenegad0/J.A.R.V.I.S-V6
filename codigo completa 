async function wiki(p){
  const q=p.toLowerCase().replace(/^(o que (é|são|significa|foi)|quem (é|foi|são|era)|qual (é|foi)|me fale sobre|fale sobre|me explique|explique|como funciona)\s+/,'').replace(/[?!.]+$/,'').trim();
  try{
    const s=await (await fetch('https://pt.wikipedia.org/w/api.php?action=query&list=search&srsearch='+encodeURIComponent(q)+'&srlimit=1&format=json&origin=*')).json();
    const it=s.query.search[0];if(!it)return null;
    const d=await (await fetch('https://pt.wikipedia.org/api/rest_v1/page/summary/'+encodeURIComponent(it.title))).json();
    return (d.extract||'').split(/(?<=[.!?])\s+/).slice(0,2).join(' ')||null;
  }catch(e){return null}
}
async function semChave(p){
  hist.push({role:'user',parts:[{text:p}]});
  const ctx=hist.slice(-7,-1).map(h=>(h.role==='user'?'Usuário: ':'Jarvis: ')+h.parts[0].text).join('\n');
  try{
    const ctl=new AbortController();const to=setTimeout(()=>ctl.abort(),14000);
    const r=await fetch('https://text.pollinations.ai/'+encodeURIComponent((ctx?ctx+'\n':'')+'Usuário: '+p)+'?model=openai&system='+encodeURIComponent(sis()),{signal:ctl.signal});
    clearTimeout(to);
    const t=(await r.text()).trim().replace(/\*/g,'');
    if(r.ok&&t&&t.length<1500&&!/^\s*[{<]/.test(t)){hist.push({role:'model',parts:[{text:t}]});return t}
  }catch(e){console.log('IA gratuita falhou:',e)}
  const w=await wiki(p);
  if(w){hist.push({role:'model',parts:[{text:w}]});return w}
  hist.pop();
  return 'Não consegui uma resposta agora. O serviço gratuito pode estar ocupado. Tente de novo em alguns segundos.';
}
