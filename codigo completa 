  rec.onend=()=>{if(ouvindo)setTimeout(()=>{try{rec.start()}catch(e){}},errRec?2000:200)};
  rec.onerror=e=>{
    if(e.error==='not-allowed'||e.error==='service-not-allowed'){desligar();$('sMic').textContent='bloqueado';return}
    if(e.error==='network'){errRec=1;$('sMic').textContent='sem internet'}
  };
  ouvindo=true;
  try{rec.start()}catch(e){}
  $('bMic').classList.add('on');
  orb.classList.add('on');orb.textContent='ESCUTANDO';$('sMic').textContent='ativo';
  return true;
}
function desligar(){
  ouvindo=false;try{rec&&rec.stop()}catch(e){}
  $('bMic').classList.remove('on');
  orb.classList.remove('on');orb.textContent='EM ESPERA';$('sMic').textContent='desligado';
}

/* ---------- STATUS ---------- */
function relogio(){const d=new Date();$('clock').textContent=d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});$('dt').textContent=d.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'})}
function status(){
  $('sNet').textContent=navigator.onLine?'online':'offline';$('sRam').textContent=performance.memory?Math.round(performance.memory.usedJSHeapSize/1048576)+' MB':'n/d';$('sRede').textContent=navigator.connection?(navigator.connection.effectiveType||'-'):'-';
  $('sIA').textContent=key?'Gemini':'modo grátis';
  if(navigator.getBattery)navigator.getBattery().then(b=>{$('sBat').textContent=Math.round(b.level*100)+'%'+(b.charging?' ⚡':'')});else $('sBat').textContent='n/d';
  if(!ouvindo)$('sMic').textContent=(window.SpeechRecognition||window.webkitSpeechRecognition)?'pronto':'use o Chrome';
}
const TEMAS=['azul','vermelho','verde'];let tema=localStorage.getItem('tema')||'azul';
const RGB={azul:'0,229,255',vermelho:'255,77,61',verde:'61,255,138'};let cor=RGB.azul;
function aplicaTema(){document.body.dataset.t=tema;cor=RGB[tema]}aplicaTema();
$('bTema').onclick=()=>{tema=TEMAS[(TEMAS.indexOf(tema)+1)%TEMAS.length];localStorage.setItem('tema',tema);aplicaTema()};
for(let k=0;k<30;k++){const b=document.createElement('i');b.style.animationDelay=(-Math.random()*0.8).toFixed(2)+'s';b.style.animationDuration=(0.45+Math.random()*0.6).toFixed(2)+'s';$('wave').appendChild(b)}
/* ---------- ANEL DE PLASMA ---------- */
const cv=$('ring'),cx=cv.getContext('2d');
function ajusta(){const w=$('ringwrap');const s=Math.max(300,Math.min(760,1.3*Math.min(w.clientWidth,w.clientHeight)));cv.width=cv.height=s;cv.style.width=cv.style.height=s+'px'}
ajusta();addEventListener('resize',ajusta);setTimeout(ajusta,300);
const NP=LEVE?44:80;
const LOOPS=Array.from({length:LEVE?8:16},()=>({r:.6+Math.random()*.12,f:[2+Math.floor(Math.random()*3),3+Math.floor(Math.random()*4),5+Math.floor(Math.random()*4)],ph:[Math.random()*6,Math.random()*6,Math.random()*6],sp:.3+Math.random()*.7,a:.5+Math.random()*.5}));
let amp=.3,ult=0;
function desenha(ts){
  requestAnimationFrame(desenha);
  if(document.hidden||viewAberta||!bootOff||ts-ult<(LEVE?55:33))return;ult=ts;
  const w=cv.width,c=w/2,t=ts/1000;
  const alvo=orb.classList.contains('fala')?1:orb.classList.contains('on')?.6:.3;
  amp+=(alvo-amp)*.06;
  cx.clearRect(0,0,w,w);
  cx.globalCompositeOperation='lighter';
  cx.shadowBlur=LEVE?0:8;
  for(const L of LOOPS){
    cx.beginPath();
    for(let k=0;k<=NP;k++){
      const a=k/NP*6.2832;let d=0;
      for(let q=0;q<3;q++)d+=Math.sin(a*L.f[q]+L.ph[q]+t*L.sp*(q+1)*.6)*(.04/(q+1));
      const rr=(L.r+d*(.6+amp*1.7))*c*1.1;
      const x=c+Math.cos(a)*rr,y=c+Math.sin(a)*rr;
      k?cx.lineTo(x,y):cx.moveTo(x,y);
    }
    cx.closePath();
    cx.strokeStyle='rgba('+cor+','+(.22+.4*L.a*(.5+amp/2))+')';
    cx.shadowColor='rgb('+cor+')';
    cx.lineWidth=1.1;cx.stroke();
  }
}
requestAnimationFrame(desenha);
card('PANORAMA PRÉVIO','Aguardando comando','Diga “Jarvis, bom dia” para o briefing',' ',true);

relogio();setInterval(relogio,15000);window.addEventListener('online',status);window.addEventListener('offline',status);

/* ---------- BOTÕES ---------- */
$('bMic').onclick=()=>{ouvindo?desligar():ligar()};
$('bKey').onclick=()=>{const k=prompt('Cole sua chave gratuita do Gemini (aistudio.google.com/apikey):',key);if(k!==null){key=k.trim();localStorage.setItem('gkey',key);status();falar(key?'Chave salva.':'Chave removida.')}};
document.querySelectorAll('[data-c]').forEach(b=>b.onclick=()=>processar(b.dataset.c));
function enviar(){const t=$('txt').value.trim();if(t){$('txt').value='';processar(t)}}
$('bEnv').onclick=enviar;$('txt').addEventListener('keydown',e=>{if(e.key==='Enter')enviar()});

/* ---------- TELA DE CARREGAMENTO ---------- */
const passos=[
  ['Iniciando núcleo do sistema',()=>true],
  ['Verificando conexão com a internet',()=>navigator.onLine],
  ['Despertando núcleo cognitivo',()=>true],
  ['Carregando memória: '+(BASE.length+M.fatos.length)+' registros',()=>true],
  ['Calibrando sintetizador de voz',()=>{carregaVozes();return 'speechSynthesis' in window}],
  ['Testando reconhecimento de voz',()=>!!(window.SpeechRecognition||window.webkitSpeechRecognition)],
  ['Conectando à IA',()=>true],
  ['Sincronizando clima e notícias',()=>true],
  ['Iniciando personalidade e humor',()=>true],
  ['Ativando autonomia e pesquisa própria',()=>true]
];
(async()=>{
  const log=$('log'),bar=$('bar').firstElementChild;
  await pingKokoro();
  passos.splice(5,0,['Voz Kokoro pf_dora: '+(kokoroOk?'conectada':'não encontrada, usando a voz do navegador'),()=>kokoroOk]);
  for(let i=0;i<passos.length;i++){
    const ok=passos[i][1]();
    log.insertAdjacentHTML('beforeend','<div>'+passos[i][0]+'... '+(ok?'<b>OK</b>':'<u>PENDENTE</u>')+'</div>');
    log.scrollTop=log.scrollHeight;
    const pc=Math.round((i+1)/passos.length*100);bar.style.width=pc+'%';$('pct').textContent=pc+'%';
    await new Promise(r=>setTimeout(r,420));
  }
  clima(true);status();
  const v=escolheVoz();
  log.insertAdjacentHTML('beforeend','<div>Voz: <b>'+(v?esc(v.name):'padrão do navegador')+'</b></div>');log.scrollTop=log.scrollHeight;
  const g=$('go');g.style.display='inline-block';
  g.onclick=()=>{$('boot').classList.add('off');bootOff=true;somAtiva();ligar();processar('bom dia');iniciarMente()};
})();
msg('Sistemas online. Diga "Jarvis, bom dia" para o briefing ou use os botões do painel central.','j');
