function toast(t){const e=$('toast');e.textContent=t;e.classList.add('v');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('v'),3500)}
function setDisp(k,v){H[k]=v;try{localStorage.setItem('casa',JSON.stringify(H))}catch(e){}toast(ICO[k]+' '+NOMES[k].toUpperCase()+' '+(v?'LIGOU':'DESLIGOU'));renderCasa()}
function renderCasa(){const d=$('devs');d.innerHTML=Object.keys(H).map(k=>'<button class="dev'+(H[k]?' on':'')+'" data-k="'+k+'"><span>'+ICO[k]+'</span>'+NOMES[k]+'<small>'+(H[k]?'LIGADO':'DESLIGADO')+'</small></button>').join('');d.querySelectorAll('button').forEach(b=>b.onclick=()=>setDisp(b.dataset.k,!H[b.dataset.k]))}
function comandoCasa(t){
  const m=t.match(/\b(deslig(?:ar|a|ue)|lig(?:ar|a|ue)|acend(?:er|a|e)|apag(?:ar|a|ue))\s+(?:a |o |as |os |todas as |todos os )?(luz|luzes|ar[- ]condicionado|ar|tv|televisão|televisao|ventilador)(?:\s+d[aeo]s?\s+(\S+))?/);
  if(!m)return null;
  const on=/^(lig|acend)/.test(m[1]),alvo=m[2];
  let ks=[];
  if(/^luz/.test(alvo)){
    if(m[3]){const k=Object.keys(H).find(x=>norm(x)===norm(m[3]));if(!k||!/escrit|sala|quarto|cozinha/.test(norm(k)))return 'Não conheço o cômodo '+m[3]+'.';ks=[k]}
    else ks=/luzes/.test(alvo)||/todas/.test(t)?['escritório','sala','quarto','cozinha']:['escritório'];
  }else if(/^ar/.test(alvo))ks=['ar-condicionado'];else if(/^tele|^tv/.test(alvo))ks=['tv'];else ks=['ventilador'];
  ks.forEach(k=>setDisp(k,on));
  return ks.length>1?'Todas as luzes '+(on?'ligadas':'desligadas')+'.':NOMES[ks[0]]+' '+(FEM(ks[0])?(on?'ligada':'desligada'):(on?'ligado':'desligado'))+'.';
}

