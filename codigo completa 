function capital(t){
  const m=t.normalize('NFD').replace(/[\u0300-\u036f]/g,'').match(/capital (?:do|da|de|dos|das)? ?(.+)/);
  if(!m)return null;
  const k=m[1].replace(/[?!.]+$/,'').trim();
  const nome=(t.match(/capital (?:do|da|de|dos|das)? ?(.+)/)||[,k])[1].replace(/[?!.]+$/,'').trim();
  return CAPS[k]?'A capital '+(k==='brasil'?'do Brasil':'de '+nome)+' é '+CAPS[k]+'.':null;
}
function calcular(t){
  let e=t.replace(/quanto (é|e|são|da|dá)/g,'').replace(/vezes|multiplicado por/g,'*').replace(/dividido por/g,'/').replace(/mais/g,'+').replace(/menos/g,'-').replace(/elevado a/g,'**').replace(/[x×]/g,'*').replace(/÷/g,'/').replace(/,/g,'.').replace(/\^/g,'**').replace(/\s+/g,'');
  if(!/^[\d+\-*/().%]+$/.test(e)||!/\d[+\-*/%]+\d/.test(e))return null;
  try{const r=Function('"use strict";return ('+e+')')();if(typeof r==='number'&&isFinite(r))return 'O resultado é '+String(+r.toFixed(6)).replace('.',',')+'.'}catch(x){}
  return null;
}
