function carregaVozes(){try{vozes=speechSynthesis.getVoices().filter(v=>/^pt/i.test(v.lang))}catch(e){vozes=[]}}
function escolheVoz(){
  const p=vozes.find(x=>x.name===localStorage.getItem('voz'));if(p)return p;
  const fem=/(maria|francisca|helena|thalita|luciana|joana|yara|brenda|giovanna|fernanda|leila|vit[oó]ria|google)/i;
  const masc=/(daniel|antonio|antônio|ricardo|felipe|male|masculin|luciano|donato|thiago|jorge|eduardo)/i;
  const br=vozes.filter(x=>/pt-BR/i.test(x.lang));
  return br.find(x=>/(natural|online)/i.test(x.name)&&!fem.test(x.name))||br.find(x=>masc.test(x.name))||br.find(x=>!fem.test(x.name))||br[0]||vozes[0]||null;
}
function motorAtual(){const m=localStorage.getItem('motor')||'auto';return m==='kokoro'?'kokoro':(m==='auto'&&kokoroOk?'kokoro':'local')}
function quebra(t){
  const out=[];let buf='';
  for(const x of (t.match(/[^.!?]+[.!?]*/g)||[t])){
    const s=x.trim();if(!s)continue;
    if(buf&&(buf+' '+s).length>170){out.push(buf);buf=s}else buf=buf?buf+' '+s:s;
    if(buf.length>=24&&/[.!?]$/.test(buf)){out.push(buf);buf=''}
  }
  if(buf){out.length&&buf.length<24?out[out.length-1]+=' '+buf:out.push(buf)}
  return out;
}
function inicioFala(){falando=true;orb.classList.add('fala');orb.textContent='FALANDO'}
function fimFala(tok){if(tok!==falaTok)return;clearTimeout(wdFala);falando=false;orb.classList.remove('fala');orb.textContent=ouvindo?'ESCUTANDO':'EM ESPERA';ignoraAte=Date.now()+1500;agendaSaida(5000)}
function falar(t,mostrar=true){
  if(mostrar){msg(t,'j');legenda(t)}
  ultFalaTxt=t;
  if(MUDO()){agendaSaida(2500+t.length*40);return}
  const mot=motorAtual();
  if(mot==='local'&&!('speechSynthesis' in window)){agendaSaida(5000+t.length*60);return}
  try{speechSynthesis.cancel()}catch(e){}
  try{kAud&&kAud.pause()}catch(e){}
  carregaVozes();
  const tok=++falaTok,fr=quebra(t);
  if(!fr.length)return;
  setTimeout(()=>{if(tok===falaTok&&!falando)agendaSaida(4000)},6000);
  clearTimeout(wdFala);
  wdFala=setTimeout(()=>{if(tok!==falaTok)return;try{speechSynthesis.cancel()}catch(e){}try{kAud&&kAud.pause()}catch(e){}falaTok++;falando=false;orb.classList.remove('fala');orb.textContent=ouvindo?'ESCUTANDO':'EM ESPERA';ignoraAte=Date.now()+1500;agendaSaida(3000)},Math.min(70000,5000+t.length*90+(mot==='kokoro'?10000:0)));
  if(mot==='kokoro')falarKokoro(fr,tok);else falarLocal(fr,tok);
}
function falarLocal(fr,tok){
  const v=escolheVoz(),rate=+(localStorage.getItem('vrate')||.92),pitch=+(localStorage.getItem('vpitch')||.72);
  let i=0,ini=false;
  const next=()=>{
    if(tok!==falaTok)return;
    if(i>=fr.length){fimFala(tok);return}
    const f=fr[i++],u=new SpeechSynthesisUtterance(f);
    u.lang='pt-BR';u.rate=rate;u.pitch=pitch;u.volume=1;if(v)u.voice=v;
    u.onstart=()=>{if(tok===falaTok&&!ini){ini=true;inicioFala()}};
    u.onend=()=>setTimeout(next,/\?$/.test(f)?280:/!$/.test(f)?220:200);
    u.onerror=e=>{if(e&&(e.error==='interrupted'||e.error==='canceled'))return;next()};
    speechSynthesis.speak(u);
  };
  next();
}
function falarKokoro(fr,tok){
  const base=kBase(),voz=localStorage.getItem('kvoz')||'pf_dora',vel=localStorage.getItem('kvel')||'1.0';
  const ps=fr.map(f=>fetch(base+'/tts?voice='+encodeURIComponent(voz)+'&speed='+vel+'&text='+encodeURIComponent(f),{signal:sigT(60000)}).then(r=>{if(!r.ok)throw new Error('http '+r.status);return r.blob()}).then(b=>URL.createObjectURL(b)));
  ps.forEach(p=>p.catch(()=>{}));
  if(!kAud)kAud=new Audio();
  const a=kAud;let i=0,ini=false;
  const falha=k=>{if(tok!==falaTok)return;kokoroOk=false;toast('🔌 KOKORO OFFLINE · USANDO A VOZ DO NAVEGADOR');falarLocal(fr.slice(k),tok)};
  const next=async()=>{
    if(tok!==falaTok){try{a.pause()}catch(e){}return}
    if(i>=fr.length){fimFala(tok);return}
    const k=i++;let u;
    try{u=await ps[k]}catch(e){falha(k);return}
    if(tok!==falaTok)return;
    a.src=u;
    a.onplaying=()=>{if(tok===falaTok&&!ini){ini=true;inicioFala()}};
    a.onended=()=>{URL.revokeObjectURL(u);setTimeout(next,120)};
    a.onerror=()=>falha(k);
    a.play().catch(()=>falha(k));
  };
  next();
}
