  bx.beginPath();
  for(const e of E){if(!e[2])continue;const a=B[e[0]],b=B[e[1]];if(!a||!b)continue;bx.moveTo(a.x,a.y);bx.lineTo(b.x,b.y)}
  bx.strokeStyle='rgba('+cor+',.07)';bx.stroke();
  for(const e of E){const a=B[e[0]],b=B[e[1]];if(!a||!b)continue;const m=Math.max(a.a,b.a);if(m>.2){bx.beginPath();bx.moveTo(a.x,a.y);bx.lineTo(b.x,b.y);bx.strokeStyle='rgba('+cor+','+(.25+.5*m)+')';bx.lineWidth=1.4;bx.stroke()}}
