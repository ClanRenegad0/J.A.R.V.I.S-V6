function ativar(txt){
  if(!G.nodes.length)return;
  const t=new Set(toks(txt));
  if(G.by.eu)G.by.eu.a=1;
  for(const n of G.nodes)if(n.tk.some(w=>t.has(w))){n.a=1;for(const e of G.edges){if(e[0]===n.id&&G.by[e[1]])G.by[e[1]].a=Math.max(G.by[e[1]].a,.6);if(e[1]===n.id&&G.by[e[0]])G.by[e[0]].a=Math.max(G.by[e[0]].a,.6)}}
