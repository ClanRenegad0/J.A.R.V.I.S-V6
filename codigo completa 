function passo(){
  const N=G.nodes;let en=0;
  for(const n of N){n.fx=0;n.fy=0}
  for(let i=0;i<N.length;i++)for(let j=i+1;j<N.length;j++){
    const a=N[i],b=N[j];let dx=a.x-b.x,dy=a.y-b.y;const d2=dx*dx+dy*dy+.01;
    if(d2>90000)continue;
    const d=Math.sqrt(d2),f=1800/d2;dx/=d;dy/=d;a.fx+=dx*f;a.fy+=dy*f;b.fx-=dx*f;b.fy-=dy*f;
  }
  for(const e of G.edges){
    const a=G.by[e[0]],b=G.by[e[1]];if(!a||!b)continue;
    const dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy)||1;
    const L=a.tipo==='core'||b.tipo==='core'?130:(a.tipo==='sub'||b.tipo==='sub'?80:50);
    const f=(d-L)*(e[2]?.004:.02);a.fx+=dx/d*f;a.fy+=dy/d*f;b.fx-=dx/d*f;b.fy-=dy/d*f;
  }
  for(const n of N){n.fx+=(bw/2-n.x)*.006;n.fy+=(bh/2-n.y)*.006;n.vx=(n.vx+n.fx)*.82;n.vy=(n.vy+n.fy)*.82;n.x+=n.vx;n.y+=n.vy;en+=Math.abs(n.vx)+Math.abs(n.vy)}
  calmo=en<N.length*.06?calmo+1:0;
}
function desenhaB(){
