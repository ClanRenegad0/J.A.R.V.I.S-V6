async function acharImagem(q){
  for(const lang of ['pt','en']){
    try{
      const j=await (await fetch('https://'+lang+'.wikipedia.org/w/api.php?action=query&generator=search&gsrsearch='+encodeURIComponent(q)+'&gsrlimit=6&prop=pageimages&piprop=thumbnail&pithumbsize=900&format=json&origin=*')).json();
      const ps=Object.values((j.query||{}).pages||{}).filter(p=>p.thumbnail).sort((a,b)=>a.index-b.index);
      if(ps.length)return{src:ps[0].thumbnail.source,tit:ps[0].title};
    }catch(e){}
  }
  try{
    const j=await (await fetch('https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6&gsrsearch='+encodeURIComponent(q)+'&gsrlimit=8&prop=imageinfo&iiprop=url|mime&iiurlwidth=900&format=json&origin=*')).json();
    const ps=Object.values((j.query||{}).pages||{}).filter(p=>p.imageinfo&&/image\/(jpeg|png)/.test(p.imageinfo[0].mime)).sort((a,b)=>a.index-b.index);
    if(ps.length)return{src:ps[0].imageinfo[0].thumburl,tit:q};
  }catch(e){}
  return null;
}
async function mostrarImagem(q){
  q=q.replace(/[?!.]+$/,'').replace(/^(?:a |uma |um |o )?(?:imagem|imagens|foto|fotos)\s+(?:d[aeo]s?|sobre)\s+/,'').trim();
  const r=await acharImagem(q);
  if(!r)return 'Não encontrei nenhuma imagem de '+q+'.';
  imgShow(r.src,r.tit,20);
  return 'Aqui está a imagem de '+q+'.';
}
function gerarImagem(q){
  q=q.replace(/[?!.]+$/,'').trim();
  const im=new Image();
  im.onload=()=>{imgShow(im.src,'Imagem gerada: '+q,20);falar('Pronto, senhor.')};
  im.onerror=()=>falar('Não consegui gerar a imagem agora.');
  im.src='https://image.pollinations.ai/prompt/'+encodeURIComponent(q)+'?width=768&height=768&nologo=true';
  return 'Gerando a imagem de '+q+'. Um instante.';
}
